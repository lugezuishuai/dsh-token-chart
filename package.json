{
  "name": "dsh-token-chart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "Token usage statistics and chart visualization for DeepSeek Harness: per-session drawer, today / last 3 / last 7 days panel, and chart configuration.",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "client",
    "src",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "meta": {
    "title": "Token 用量图表",
    "description": "统计并可视化 Token 用量：会话抽屉、今天 / 近 3 天 / 近 7 天面板与图表配置。"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "npm run build:host && npm run build:styles && npm run build:client && npm run build:chunk",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "build:chunk": "node scripts/build-chunk.mjs",
    "test": "vitest run",
    "test:host": "vitest run --project host",
    "test:client": "vitest run --project client",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'test/**/*.mjs' 'scripts/**/*.mjs'",
    "test:watch": "vitest",
    "build:styles": "node scripts/build-styles.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "echarts": "^6.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "less": "^4.9.1",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "types": "lib/types/index.d.ts"
}
