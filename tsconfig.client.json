{
  // Typecheck-only project for the browser half (src/client), which esbuild
  // bundles into client/client.js as a window.__ModuleLoader__ factory.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["react", "react-dom"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/client"]
}
